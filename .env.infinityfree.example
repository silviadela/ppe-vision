APP_NAME="PPE Vision"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://SUBDOMAIN_ANDA.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning

# Salin persis nilai MySQL dari control panel InfinityFree.
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_ppe
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=PASSWORD_DATABASE

# Driver file/sync dipakai karena paket gratis tidak menjalankan worker.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
PUBLIC_DISK_ROOT=public/storage
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Streamlit hanya menjadi mesin/panel deteksi di dalam dashboard Laravel.
YOLO_API_URL=
STREAMLIT_DEMO_URL=https://ppe-vision-lculpeehh7bzalqxpwtbf5.streamlit.app

OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
ALLOW_ADMIN_WRITES=false

# Token yang sama dengan SUMMARY_SYNC_TOKEN pada komputer lokal.
# Gunakan nilai acak panjang dan jangan commit .env.
SUMMARY_SYNC_TOKEN=

# Ganti dengan token acak panjang. Kosongkan segera setelah /install berhasil.
INFINITYFREE_INSTALL_TOKEN=
