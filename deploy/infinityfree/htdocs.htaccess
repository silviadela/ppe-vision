RewriteEngine On
Options -Indexes

# Jangan pernah layani file tersembunyi seperti .env melalui HTTP.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-src 'self' https://*.streamlit.app; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# Arahkan document root InfinityFree ke folder public Laravel,
# tetapi jangan menulis ulang permintaan yang sudah berada di sana.
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteRule ^(.*)$ public/$1 [L]
