APP_NAME="PPE Vision"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://NAMA_AKUN.alwaysdata.net

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql-NAMA_AKUN.alwaysdata.net
DB_PORT=3306
DB_DATABASE=NAMA_AKUN_ppe_vision
DB_USERNAME=NAMA_USER_DATABASE
DB_PASSWORD=PASSWORD_DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@NAMA_AKUN.alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Inferensi online tetap dijalankan Streamlit dan ditampilkan di dalam Laravel.
YOLO_API_URL=
STREAMLIT_DEMO_URL=https://ppe-vision-lculpeehh7bzalqxpwtbf5.streamlit.app

# Ringkasan default menggunakan analisis lokal berbasis aturan.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
